{
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/(css|js|icons)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "regions": [
    "icn1"
  ],
  "functions": {
    "api/lotto.js": {
      "maxDuration": 10
    },
    "api/dream.js": {
      "maxDuration": 30,
      "includeFiles": "src/dream.js"
    },
    "api/share.js": {
      "maxDuration": 10,
      "includeFiles": "{public/index.html,public/js/core.js,public/js/lunar.js}"
    },
    "api/og.js": {
      "maxDuration": 15,
      "includeFiles": "{public/js/core.js,public/js/lunar.js,api/_assets/**}"
    }
  },
  "rewrites": [
    {
      "source": "/s/:code",
      "destination": "/api/share?r=:code"
    }
  ]
}
