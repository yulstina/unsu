{
  "headers": [
    {
      "source": "/api/(me|coins|pay|auth)(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/(css|js|icons)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "regions": [
    "icn1"
  ],
  "functions": {
    "api/dream.js": {
      "maxDuration": 30,
      "includeFiles": "src/dream.js"
    },
    "api/share.js": {
      "maxDuration": 10,
      "includeFiles": "{public/index.html,public/js/core.js,public/js/lunar.js}"
    },
    "api/og.js": {
      "maxDuration": 15,
      "includeFiles": "{public/js/core.js,public/js/lunar.js,api/_assets/**}"
    },
    "api/auth.js": {
      "maxDuration": 10
    },
    "api/me.js": {
      "maxDuration": 10
    },
    "api/coins.js": {
      "maxDuration": 10
    },
    "api/pay.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/auth/kakao",
      "destination": "/api/auth?a=kakao"
    },
    {
      "source": "/auth/kakao/callback",
      "destination": "/api/auth?a=callback"
    },
    {
      "source": "/auth/google",
      "destination": "/api/auth?a=google"
    },
    {
      "source": "/auth/google/callback",
      "destination": "/api/auth?a=gcallback"
    },
    {
      "source": "/pay/success",
      "destination": "/api/pay?a=confirm"
    },
    {
      "source": "/s/:code",
      "destination": "/api/share?r=:code"
    }
  ]
}
